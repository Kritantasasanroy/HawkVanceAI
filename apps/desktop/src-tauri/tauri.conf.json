{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HawkVance AI",
  "version": "0.1.0",
  "identifier": "ai.hawkvance.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HawkVance AI",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://*.neon.tech https://*.neonauth.ap-southeast-2.aws.neon.tech http://localhost:8080"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "HawkVance",
    "copyright": "Copyright HawkVance",
    "shortDescription": "Your personal AI memory layer",
    "longDescription": "HawkVance AI keeps your documents, memory and context on your machine, and sends only sanitised, approved context to the AI model you choose.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "resources/engine": "engine"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.hawkvance.ai/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCNUFFNUU2NEYxMTU1OApSV1JZRmZGa1hxNjFDdEVEOHNOUWI5QlBrMG9PTG1LeFRPRVdMRjdnUjh5am14QWJVN0x0NCs0dgo="
    }
  }
}
