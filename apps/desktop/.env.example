# Copy to .env before building. These are baked into the bundle at build time, so a build made
# with the localhost value works only on a machine that is also running the API.
VITE_API_BASE_URL=http://localhost:8080

# The Neon Auth project endpoint the sign-in screen sends email codes through.
VITE_NEON_AUTH_URL=https://<your-project>.neonauth.<region>.aws.neon.tech/neondb/auth
